{
  "name": "ai-flaw-reporting-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "client:dev": "yarn workspace client dev",
    "client:build": "yarn workspace client build",
    "client:lint": "yarn workspace client lint",
    "client:format": "yarn workspace client format:write",
    "client:storybook": "yarn workspace client storybook",
    "server:dev": "yarn workspace server develop",
    "server:build": "yarn workspace server build",
    "dev": "concurrently \"yarn client:dev\" \"yarn server:dev\"",
    "build": "yarn client:build && yarn server:build",
    "lint": "yarn client:lint"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "concurrently": "^9.2.1"
  },
  "workspaces": {
    "packages": [
      "client",
      "server"
    ],
    "nohoist": [
      "**/storybook",
      "**/@storybook/**",
      "**/@hookform/**",
      "**/zod"
    ]
  },
  "packageManager": "yarn@1.22.22"
}
